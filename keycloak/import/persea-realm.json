{
  "realm": "persea",
  "enabled": true,
  "registrationAllowed": true,
  "revokeRefreshToken": true,
  "refreshTokenMaxReuse": 0,

  "roles": {
    "realm": [
      { "name": "app_user",  "composite": false },
      { "name": "moderator", "composite": false },
      { "name": "admin",     "composite": false }
    ]
  },

  "defaultRoles": ["app_user"],

  "clients": [
    {
      "clientId": "android-app",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "protocol": "openid-connect",

      "redirectUris": [
        "com.example.androidapp://*",
        "https://oauth.pstmn.io/v1/callback"
      ],
      "webOrigins": [],

      "attributes": {
        "pkce.code.challenge.method": "S256",
        "use.refresh.tokens": "true"
      }
    },
    {
      "clientId": "persea-web",
      "name": "Persea Web",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "protocol": "openid-connect",

      "redirectUris": [
        "http://localhost:5173/*",
        "http://localhost:5174/*",
        "http://localhost:4173/*",
        "http://127.0.0.1:5173/*",
        "http://127.0.0.1:5174/*",
        "http://127.0.0.1:4173/*"
      ],
      "webOrigins": [
        "http://localhost:5173",
        "http://localhost:5174",
        "http://localhost:4173",
        "http://127.0.0.1:5173",
        "http://127.0.0.1:5174",
        "http://127.0.0.1:4173"
      ],

      "attributes": {
        "pkce.code.challenge.method": "S256",
        "use.refresh.tokens": "true",
        "post.logout.redirect.uris": "+"
      }
    },
    {
      "clientId": "postman-tests",
      "name": "Postman Test Runner",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "protocol": "openid-connect"
    }
  ],

  "users": [
    {
      "username": "test_user",
      "email": "test_user@persea.local",
      "firstName": "Test",
      "lastName": "User",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "user1234",
          "temporary": false
        }
      ],
      "realmRoles": ["app_user"]
    },
    {
      "username": "test_moderator",
      "email": "test_moderator@persea.local",
      "firstName": "Test",
      "lastName": "Moderator",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "moder1234",
          "temporary": false
        }
      ],
      "realmRoles": ["moderator"]
    },
    {
      "username": "test_admin",
      "email": "test_admin@persea.local",
      "firstName": "Test",
      "lastName": "Admin",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "admin1234",
          "temporary": false
        }
      ],
      "realmRoles": ["admin"]
    }
  ]
}
