{
  "realm": "persea",
  "enabled": true,
  "registrationAllowed": true,

  "roles": {
    "realm": [
      { "name": "app_user",  "composite": false },
      { "name": "moderator", "composite": false },
      { "name": "admin",     "composite": false }
    ]
  },

  "defaultRoles": ["app_user"],

  "clients": [
    {
      "clientId": "android-app",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "protocol": "openid-connect",

      "redirectUris": [
        "com.example.androidapp://*",
        "https://oauth.pstmn.io/v1/callback"
      ],
      "webOrigins": [],

      "attributes": {
        "pkce.code.challenge.method": "S256",
        "use.refresh.tokens": "true"
      }
    }
  ],

  "users": [
    {
      "username": "test_user",
      "email": "test_user@persea.local",
      "firstName": "Test",
      "lastName": "User",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "user1234",
          "temporary": false
        }
      ],
      "realmRoles": ["app_user"]
    },
    {
      "username": "test_moderator",
      "email": "test_moderator@persea.local",
      "firstName": "Test",
      "lastName": "Moderator",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "moder1234",
          "temporary": false
        }
      ],
      "realmRoles": ["moderator"]
    },
    {
      "username": "test_admin",
      "email": "test_admin@persea.local",
      "firstName": "Test",
      "lastName": "Admin",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "admin1234",
          "temporary": false
        }
      ],
      "realmRoles": ["admin"]
    }
  ]
}