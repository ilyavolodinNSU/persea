      "name": "1. Data Creation (Product CDC -> Reco/User)",
      "item": [
        {
          "name": "1.1 [Product] Create Category",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "// Уникальное имя через timestamp, code всегда WATER — единственный поддерживаемый RatingCalculator",
