  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const tokenLeewayMs = 60000;",
          "function readVar(key, fallback) {",
          "    return pm.environment.get(key) || pm.collectionVariables.get(key) || fallback;",
          "}",
          "function writeVar(key, value) {",
          "    pm.collectionVariables.set(key, value);",
          "    try { pm.environment.set(key, value); } catch (e) {}",
          "}",
          "function isTokenFresh(token) {",
          "    if (!token) return false;",
          "    try {",
          "        const payloadPart = token.split('.')[1];",
          "        if (!payloadPart) return false;",
          "        const normalized = payloadPart.replace(/-/g, '+').replace(/_/g, '/');",
          "        const padding = '='.repeat((4 - normalized.length % 4) % 4);",
          "        const payload = JSON.parse(atob(normalized + padding));",
          "        return payload.exp && payload.exp * 1000 > Date.now() + tokenLeewayMs;",
          "    } catch (e) {",
          "        return false;",
          "    }",
          "}",
          "function useToken(token) {",
          "    writeVar('token', token);",
          "    pm.request.headers.upsert({ key: 'Authorization', value: 'Bearer ' + token });",
          "}",
          "const currentToken = readVar('token', '');",
          "if (isTokenFresh(currentToken)) {",
          "    useToken(currentToken);",
          "} else {",
          "    const keycloakUrl = readVar('keycloak_url', 'http://localhost:8080');",
          "    const realm = readVar('auth_realm', 'persea');",
          "    pm.sendRequest({",
          "        url: keycloakUrl + '/realms/' + realm + '/protocol/openid-connect/token',",
          "        method: 'POST',",
          "        header: { 'Content-Type': 'application/x-www-form-urlencoded' },",
          "        body: {",
          "            mode: 'urlencoded',",
          "            urlencoded: [",
          "                { key: 'grant_type', value: 'password' },",
          "                { key: 'client_id', value: readVar('auth_client_id', 'postman-tests') },",
          "                { key: 'username', value: readVar('auth_username', 'test_admin') },",
          "                { key: 'password', value: readVar('auth_password', 'admin1234') },",
          "                { key: 'scope', value: 'openid profile email' }",
          "            ]",
          "        }",
          "    }, function (err, res) {",
          "        if (err) throw new Error('Keycloak token request failed: ' + err);",
          "        if (!res || res.code >= 400) {",
          "            throw new Error('Keycloak token request failed: HTTP ' + (res && res.code) + ' ' + (res && res.text()));",
          "        }",
          "        const body = res.json();",
          "        if (!body.access_token) throw new Error('Keycloak response does not contain access_token');",
          "        useToken(body.access_token);",
          "    });",
          "}"
        ]
      }
    }
  ]
