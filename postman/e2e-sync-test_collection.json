        {
          "name": "1.3 [Product] Create Product",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "function randomEan13() {",
                  "    var body = '46' + Math.floor(1000000000 + Math.random() * 9000000000).toString();",
                  "    var sum = body.split('').reduce(function(acc, ch, index) {",
                  "        var digit = parseInt(ch, 10);",
                  "        return acc + digit * (index % 2 === 0 ? 1 : 3);",
                  "    }, 0);",
                  "    return body + ((10 - (sum % 10)) % 10);",
                  "}",
                  "pm.collectionVariables.set('product_name', 'SyncProduct_' + Date.now());",
                  "pm.collectionVariables.set('product_barcode', randomEan13());"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 201', function(){ pm.response.to.have.status(201); });",
                  "pm.collectionVariables.set('product_id', pm.response.json().id);",
                  "pm.test('Product barcode is returned', function(){",
                  "    pm.expect(pm.response.json().barcode).to.eql(pm.collectionVariables.get('product_barcode'));",
                  "});",
                  "// Ждём Kafka CDC: product -> user-service и rec-service",
                  "var start = Date.now();",
                  "while (Date.now() - start < 3000) {}"
                ],
                "type": "text/javascript"
              }
            }
          ],
