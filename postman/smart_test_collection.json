  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8084",
      "type": "string"
    },
    {
      "key": "cat_id",
      "value": "1",
      "type": "string"
    },
    {
      "key": "brand_id",
      "value": "1",
      "type": "string"
    },
    {
      "key": "type_id",
