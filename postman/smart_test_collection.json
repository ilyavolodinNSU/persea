      "value": "1",
      "type": "string"
    },
    {
      "key": "enum_val_id",
      "value": "1",
      "type": "string"
    },
    {
      "key": "keycloak_url",
      "value": "http://localhost:8080",
      "type": "string"
    },
    {
      "key": "auth_realm",
      "value": "persea",
      "type": "string"
    },
    {
      "key": "auth_client_id",
      "value": "postman-tests",
      "type": "string"
    },
    {
      "key": "auth_username",
      "value": "test_admin",
      "type": "string"
    },
    {
      "key": "auth_password",
      "value": "admin1234",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Category",
      "item": [
        {
          "name": "1. Create Category",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/products/categories",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "products",
                "categories"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"{{cat_name}}\",\n  \"code\": \"{{cat_code}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "var ts = Date.now();",
                  "pm.collectionVariables.set('cat_name', 'Cat_' + ts);",
                  "pm.collectionVariables.set('cat_code', 'WATER');"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 201\", function () { pm.response.to.have.status(201); });",
                  "var jsonData = pm.response.json();",
                  "if (jsonData && jsonData.id) { pm.collectionVariables.set(\"cat_id\", jsonData.id); }"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "2. Get Category by ID",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/products/categories/{{cat_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "products",
                "categories",
                "{{cat_id}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ]
        },
        {
          "name": "3. Update Category",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/products/categories/{{cat_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "products",
                "categories",
                "{{cat_id}}"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"{{cat_name}}_v2\",\n  \"code\": \"{{cat_code}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ]
        }
      ]
    },
